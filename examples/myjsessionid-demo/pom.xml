<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.6.12</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.kikop</groupId>
    <artifactId>myjsessionid-demo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>${project.artifactId}</name>
    <description>员工请假审批系统</description>

    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
    </properties>
    <dependencies>

        <!-- spring-boot-starter-web-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 4.lombok-->
        <!-- compile:打包时会把 lombok.jar 打进最终 jar（浪费空间）-->
        <!-- provided:编译时需要，但不打包进最终产物-->
        <!-- Spring Boot 的 spring-boot-dependencies 已经管理了 Lombok 版本-->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>


    <build>
        <plugins>

            <!--spring-boot-maven-plugin-->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.kikop.MyFlowableDemoApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <!-- 1.run-->
                            <!-- 开发阶段,允许直接通过Maven运行Spring Boot应用（无需先打包），适用快速测试‌-->
                            <!-- <goal>run</goal>-->
                            <!-- 2.build-info-->
                            <!-- 构建信息文件（META-INF/build-info.properties），包含版本、时间等元数据‌-->
                            <!-- <goal>build-info</goal>-->
                            <!-- 3.repackage-->
                            <!-- 打包阶段,必须配置此目标才能生成可执行jar,这是最常用的目标，会将项目打包为可执行的jar/war文件，并替换默认生成的包。-->
                            <!-- 该目标会在Maven的package阶段自动执行，生成包含所有依赖的"fat jar"-->
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
