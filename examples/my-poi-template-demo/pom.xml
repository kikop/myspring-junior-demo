<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>org.kikop3</groupId>
    <artifactId>my-poi-template-demo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>my-poi-template-demo</name>
    <description>my-poi-template-demo basedv1.10.6</description>

    <properties>
        <!-- <java.version>17</java.version>-->
        <!-- 跳过 mvn deploy 阶段，不把 jar 推到远程 Maven 仓库 -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <repositories>
        <repository>
            <id>AsposeJavaAPI</id>
            <name>Aspose Java API</name>
            <url>https://releases.aspose.com/java/repo/</url>
        </repository>
    </repositories>


    <dependencies>

        <!-- 1.poi-tl -->
        <dependency>
            <groupId>com.deepoove</groupId>
            <artifactId>poi-tl</artifactId>
            <version>1.10.6</version>
        </dependency>

        <!-- 2.如果 starter 需要 web 能力 -->
        <!-- optional:true:我用它，但我不强制你也用它-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

<!--        3.spring-expression-->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-expression</artifactId>
            <version>6.2.6</version>
        </dependency>

        <dependency>
            <groupId>com.deepoove</groupId>
            <artifactId>poi-tl-plugin-markdown</artifactId>
            <version>1.0.3</version>
        </dependency>



<!--        4.aspose-words-->
        <!--        JDK 17 用 jdk17；JDK 8 用 jdk8；JDK 11 用 jdk11。-->
        <!--        则阿里云会把 com.aspose:aspose-words 拦截掉，报：-->
        <dependency>
            <groupId>com.aspose</groupId>
            <artifactId>aspose-words</artifactId>
            <version>25.1</version>
            <classifier>jdk17</classifier>
        </dependency>


        <!-- slf4j + logback 桥接 -->
        <!--        poi-tl使用slf4j作为日志门面 -->
        <!--        版本对应关系:-->
        <!--        poi-tl v1.10.6内置slf4j-api v2.0.17-->
        <!--        logback 1.2.x（只认 SLF4J 1.7）-->
        <!--        springboot版本自动寻找logback 1.5.18(slf4j-api v2.0.17)-->

        <!--        logback 删掉 version，让 Spring Boot 管 v1.5.18-->
