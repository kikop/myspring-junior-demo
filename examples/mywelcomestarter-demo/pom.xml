<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.kikop</groupId>
    <artifactId>mywelcomestarter-demo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>${project.artifactId}</name>
    <description>自定义welcome-spring-booter-starter启动器调用示例,springboot版本v3.4.5</description>


    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>

    </properties>
    <dependencies>

        <!-- spring-boot-starter-web-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>


        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.xxxkikop</groupId>
            <artifactId>welcome-spring-boot-starter</artifactId>
            <version>0.0.3-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <!-- proviced:编译、测试,不会打进 jar，也不会传递依赖-->
            <!-- eg:servlet-api-->
            <scope>provided</scope>
        </dependency>

    </dependencies>


    <build>
        <plugins>
            <!--spring-boot-maven-plugin-->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>

                <executions>
                    <execution>
                        <goals>
                            <!-- 1.run-->
                            <!-- 开发阶段,允许直接通过Maven运行Spring Boot应用（无需先打包），适用快速测试‌-->
                            <!-- <goal>run</goal>-->
                            <!-- 2.build-info-->
                            <!-- 构建信息文件（META-INF/build-info.properties），包含版本、时间等元数据‌-->
                            <!-- <goal>build-info</goal>-->
                            <!-- 3.repackage-->
                            <!-- 打包阶段,必须配置此目标才能生成可执行jar,这是最常用的目标，会将项目打包为可执行的jar/war文件，并替换默认生成的包。-->
                            <!-- 该目标会在Maven的package阶段自动执行，生成包含所有依赖的"fat jar"-->
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
